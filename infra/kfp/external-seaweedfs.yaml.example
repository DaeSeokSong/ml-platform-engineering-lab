apiVersion: v1
kind: Service
metadata:
  name: external-seaweedfs
  namespace: kubeflow
spec:
  ports:
    - name: s3
      port: 8333
      targetPort: 8333
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: external-seaweedfs-manual
  namespace: kubeflow
  labels:
    kubernetes.io/service-name: external-seaweedfs
    endpointslice.kubernetes.io/managed-by: study-manual
addressType: IPv4
ports:
  - name: s3
    protocol: TCP
    port: 8333
endpoints:
  - addresses: ["${SEAWEED_KIND_IP}"]
    conditions:
      ready: true
---
apiVersion: v1
kind: Service
metadata:
  name: ml-platform-seaweedfs
  namespace: kubeflow
spec:
  type: ExternalName
  externalName: external-seaweedfs.kubeflow.svc.cluster.local
